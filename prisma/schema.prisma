generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/app.db"
}

model Record {
  id        Int      @id @default(autoincrement())
  startAt   DateTime
  endAt     DateTime
  action    String?
  method    String?
  tool      String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([endAt])
}

